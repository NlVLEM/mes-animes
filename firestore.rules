rules_version = '2';
// Règles de sécurité de la base Mes Animes.
// - Les profils sont privés par défaut : pour voir la liste de quelqu'un, il faut lui envoyer une demande et qu'il l'accepte.
// - Le haut du profil (pseudo, bio, couleur, bannière, nombre d'abonnés) reste visible par les personnes connectées, pour pouvoir se trouver.
// - Chacun ne peut modifier que son propre profil et sa propre liste. Un abonné peut seulement se retirer lui-même des abonnés de quelqu'un.
// - Un pseudo n'appartient qu'à une seule personne.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    match /pseudos/{p} {
      allow read: if signedIn();
      allow create: if signedIn()
        && p.matches('^[a-z0-9_.-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'pseudo'])
        && request.resource.data.uid == me()
        && request.resource.data.pseudo.lower() == p;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /users/{uid} {
      // can the person asking see this user's list?
      function canSee() {
        let p = get(/databases/$(database)/documents/users/$(uid)).data;
        return p.get('private', true) == false || me() in p.get('followers', []);
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['pseudo', 'platforms', 'following', 'followers', 'private', 'updated', 'bio', 'color', 'banner'])
          && (!('bio' in d) || (d.bio is string && d.bio.size() <= 160))
          && (!('color' in d) || (d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')))
          && (!('banner' in d) || (d.banner is string && d.banner.size() <= 80))
          && d.pseudo is string
          && getAfter(/databases/$(database)/documents/pseudos/$(d.pseudo.lower())).data.uid == uid
          && (!('following' in d) || (d.following is list && d.following.size() <= 300))
          && (!('followers' in d) || (d.followers is list && d.followers.size() <= 1000))
          && (!('platforms' in d) || (d.platforms is list && d.platforms.size() <= 20))
          && (!('private' in d) || d.private is bool);
      }
      // a follower removing only themselves from someone's followers
      function leaving() {
        let before = resource.data.get('followers', []);
        let after = request.resource.data.get('followers', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
          && me() in before && !(me() in after) && before.hasAll(after) && after.size() == before.size() - 1;
      }

      allow read: if signedIn();
      allow create: if signedIn() && me() == uid && validProfile();
      allow update: if signedIn() && ((me() == uid && validProfile()) || (me() != uid && leaving()));
      allow delete: if signedIn() && me() == uid;

      match /list/{item} {
        allow read: if signedIn() && (me() == uid || canSee());
        allow write: if signedIn() && me() == uid && item.matches('^(tv|movie)-[0-9]{1,12}$');
      }

      // follow requests sent to this user, one per sender
      match /requests/{from} {
        allow read: if signedIn() && (me() == uid || me() == from);
        allow create: if signedIn() && me() == from && from != uid
          && request.resource.data.keys().hasOnly(['pseudo', 'at'])
          && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20
          && request.resource.data.at is number;
        allow delete: if signedIn() && (me() == uid || me() == from);
      }
    }
  }
}
